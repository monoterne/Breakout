{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Breakout",
            "type": "cppbuild",
            "command": "/usr/bin/env",
            "args": ["CXXFLAGS=-g", "./build.sh"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
